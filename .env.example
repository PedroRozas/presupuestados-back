SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHATBOT_MODEL=gpt-5.4-mini
OPENAI_CHATBOT_GUARD_MODEL=gpt-5-nano
OPENAI_CHATBOT_REASONING_EFFORT=low
OPENAI_CHATBOT_TIMEOUT_MS=20000
OPENAI_MODEL=gpt-5-nano
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
REDIS_URL=redis://default:<password>@<host>:6379/0
RATE_LIMIT_HASH_SALT=change-me-to-a-long-random-string
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_EMAIL_MAX=5
RATE_LIMIT_AUTH_COMBO_MAX=5
RATE_LIMIT_AUTH_COOLDOWN_SECONDS=900
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
