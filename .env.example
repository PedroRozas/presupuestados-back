RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_CHATBOT_WINDOW_SECONDS=60
RATE_LIMIT_CHATBOT_MAX=10
RATE_LIMIT_CHATBOT_IP_WINDOW_SECONDS=600
RATE_LIMIT_CHATBOT_IP_MAX=30
RATE_LIMIT_AI_WINDOW_SECONDS=300
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_IP_WINDOW_SECONDS=900
RATE_LIMIT_AI_IP_MAX=10
RATE_LIMIT_PASSWORD_UPDATE_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_UPDATE_USER_MAX=5
RATE_LIMIT_PASSWORD_UPDATE_IP_MAX=10
RATE_LIMIT_PASSWORD_UPDATE_COOLDOWN_SECONDS=900
RATE_LIMIT_AUTH_INITIALIZE_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_INITIALIZE_USER_MAX=10
RATE_LIMIT_COUPLE_JOIN_WINDOW_SECONDS=900
RATE_LIMIT_COUPLE_JOIN_USER_MAX=5
RATE_LIMIT_COUPLE_JOIN_IP_MAX=10
RATE_LIMIT_PARTNER_INVITE_WINDOW_SECONDS=3600
RATE_LIMIT_PARTNER_INVITE_USER_MAX=10
RECEIPT_WORKER_ENABLED=true
RECEIPT_WA_APP_SECRET=meta-app-secret
RECEIPT_WA_VERIFY_TOKEN=un-token-largo-aleatorio
RECEIPT_WA_ACCESS_TOKEN=meta-system-user-token
RECEIPT_WA_PHONE_NUMBER_ID=000000000000000
RECEIPT_WA_GRAPH_API_VERSION=v21.0
RECEIPT_MEDIA_SOURCE=real
RECEIPT_MESSAGING_SOURCE=real
RECEIPT_TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
RECEIPT_TELEGRAM_WEBHOOK_SECRET=otro-token-largo-aleatorio
RECEIPT_TELEGRAM_API_BASE_URL=https://api.telegram.org
RECEIPT_LOCAL_MEDIA_DIR=./tmp/receipt-media
RECEIPT_STORAGE_BUCKET=receipts
RECEIPT_SIGNED_URL_TTL_SECONDS=300
RECEIPT_GROUP_WINDOW_SECONDS=90
RECEIPT_WEBP_QUALITY=90
RECEIPT_MAX_WIDTH_PX=2000
RECEIPT_RATE_LIMIT_WINDOW_SECONDS=60
RECEIPT_RATE_LIMIT_MAX=20
RECEIPT_WORKER_CONCURRENCY=1
# Mantener en 1: la asignación de page_index no es atómica y con concurrencia >1 dos fotos del mismo grupo pueden pisarse en Storage
RECEIPT_RETRY_BACKOFF_MS=5000
RECEIPT_EXTRACTION_MODEL=gpt-5.4-mini
RECEIPT_EXTRACTION_MAX_OUTPUT_TOKENS=8000
RECEIPT_EXTRACTION_TIMEOUT_MS=90000
RECEIPT_EXTRACTION_TEMPERATURE=0
RECEIPT_EXTRACTION_REASONING_EFFORT=
RECEIPT_MIN_CONFIDENCE=0.85
RECEIPT_TOTAL_TOLERANCE_CLP=50
RECEIPT_MONTHLY_EXTRACTION_CAP=300
RECEIPT_NORMALIZATION_MODEL=gpt-5-nano
RECEIPT_NORMALIZATION_MAX_OUTPUT_TOKENS=2000
RECEIPT_NORMALIZATION_TIMEOUT_MS=30000
RECEIPT_NORMALIZATION_TEMPERATURE=
RECEIPT_NORMALIZATION_REASONING_EFFORT=minimal
RECEIPT_MATCH_HIGH=0.6
RECEIPT_MATCH_LOW=0.3
RECEIPT_CANDIDATE_LIMIT=5
RECEIPT_SWEEP_INTERVAL_MINUTES=10
RECEIPT_STALE_EXTRACTING_MINUTES=30
RECEIPT_QUERY_MODEL=gpt-5.4-mini
RECEIPT_QUERY_MAX_OUTPUT_TOKENS=800
RECEIPT_QUERY_MAX_TOOL_ROUNDS=3
RECEIPT_QUERY_TIMEOUT_MS=30000
RECEIPT_QUERY_TEMPERATURE=0
RECEIPT_QUERY_REASONING_EFFORT=
